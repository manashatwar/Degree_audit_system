import React, { useState, useEffect } from 'react';
import { useAuth } from '../../contexts/AuthContext';
import { studentService } from '../../services/studentService';
import Layout from '../../components/Layout';
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '../../components/ui/card';
import { Badge } from '../../components/ui/badge';
import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from '../../components/ui/table';
import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from '../../components/ui/select';
import { GraduationCap, BookOpen, TrendingUp, CheckCircle, AlertCircle, XCircle, Award, Calendar } from 'lucide-react';

export default function StudentDashboard() {
  const { user } = useAuth();
  const [audit, setAudit] = useState(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState(null);
  const [selectedSemester, setSelectedSemester] = useState('all');
  const [activeTab, setActiveTab] = useState('registered'); // New state for tabs

  export default function StudentDashboard() {
    const { user } = useAuth();
    const [audit, setAudit] = useState(null);
    const [loading, setLoading] = useState(true);
    const [error, setError] = useState(null);
    const [selectedSemester, setSelectedSemester] = useState('all');

    useEffect(() => {
      loadAudit();
    }, []);

    const loadAudit = async () => {
      try {
        setLoading(true);
        const auditData = await studentService.getAudit(user.studentId);
        setAudit(auditData);
        // Set selected semester to current semester by default
        if (auditData.completedCourses.length > 0) {
          const semesters = [...new Set(auditData.completedCourses.map(c => c.semester))];
          setSelectedSemester(semesters[semesters.length - 1] || 'all');
        }
      } catch (err) {
        setError(err.response?.data?.message || 'Failed to load audit data');
      } finally {
        setLoading(false);
      }
    };

    // Get grade point from letter grade (LNMIIT grading system)
    const getGradePoint = (grade) => {
      if (typeof grade === 'number') return grade;
      const gradeMap = {
        'A': 10, 'AB': 9, 'B': 8, 'BC': 7,
        'C': 6, 'CD': 5, 'D': 4, 'F': 0
      };
      return gradeMap[grade?.toUpperCase()] || 0;
    };

    // Check if course is passed (D grade or higher)
    const isPassed = (grade) => {
      const gradePoint = getGradePoint(grade);
      return gradePoint >= 4; // D grade or higher
    };

    // Check if course can be repeated for improvement (CD or F)
    const canRepeat = (grade) => {
      const upperGrade = grade?.toString().toUpperCase();
      return upperGrade === 'CD' || upperGrade === 'F';
    };

    // Check if course must be repeated (F grade)
    const mustRepeat = (grade) => {
      return grade?.toString().toUpperCase() === 'F';
    };

    // Get credit status
    const getCreditStatus = (course) => {
      if (isPassed(course.grade)) {
        return { status: 'Done', color: 'text-green-600 bg-green-50' };
      } else {
        return { status: 'Not Done', color: 'text-red-600 bg-red-50' };
      }
    };

    // Group courses by semester
    const getAllSemesters = () => {
      if (!audit) return [];
      const semesters = [...new Set(audit.completedCourses.map(c => c.semester))];
      return semesters.sort();
    };

    // Get courses for selected semester
    const getFilteredCourses = () => {
      if (!audit) return [];
      if (selectedSemester === 'all') return audit.completedCourses;
      return audit.completedCourses.filter(c => c.semester === selectedSemester);
    };

    // Calculate semester performance
    const calculateSemesterPerformance = (courses) => {
      let totalCredits = 0;
      let totalGradePoints = 0;

      courses.forEach(course => {
        const credits = course.credits || 0;
        const gradePoint = getGradePoint(course.grade);
        totalCredits += credits;
        totalGradePoints += credits * gradePoint;
      });

      const spi = totalCredits > 0 ? (totalGradePoints / totalCredits).toFixed(2) : '0.00';
      return { totalCredits, totalGradePoints: totalGradePoints.toFixed(2), spi };
    };

    if (loading) {
      return (
        <Layout>
          <div className="flex items-center justify-center h-96">
            <div className="text-center">
              <div className="animate-spin rounded-full h-12 w-12 border-b-2 border-blue-600 mx-auto"></div>
              <p className="mt-4 text-gray-600">Loading student information...</p>
            </div>
          </div>
        </Layout>
      );
    }

    if (error) {
      return (
        <Layout>
          <div className="bg-red-50 border border-red-200 rounded-lg p-6">
            <p className="text-red-800">{error}</p>
          </div>
        </Layout>
      );
    }

    const semesters = getAllSemesters();
    const filteredCourses = getFilteredCourses();
    const semesterPerf = calculateSemesterPerformance(filteredCourses);

    // Categorize courses
    const failedCourses = audit.completedCourses.filter(c => mustRepeat(c.grade)); // F grade - compulsory repeat
    const improvementCourses = audit.completedCourses.filter(c => {
      const grade = c.grade?.toString().toUpperCase();
      return grade === 'CD' || (isPassed(c.grade) && getGradePoint(c.grade) < 10); // CD or any passed grade that can be improved
    });
    const compulsoryCourses = audit.completedCourses.filter(c =>
      (c.courseType === 'Core' || c.courseType === 'PC') && !isPassed(c.grade)
    ); // Core courses not yet passed

    return (
      <Layout>
        <div className="space-y-6">
          {/* Page Header */}
          <div className="bg-white border-b border-gray-200 rounded-lg p-6">
            <div className="flex items-center justify-between">
              <div>
                <h1 className="text-2xl font-bold text-gray-900">Student Information</h1>
                <p className="text-sm text-gray-600 mt-1">
                  {audit.studentName} • {audit.studentId} • {audit.program} • {audit.department}
                </p>
              </div>
              <div className="text-right">
                <p className="text-sm text-gray-600">Batch Year</p>
                <p className="text-lg font-semibold text-gray-900">{audit.batchYear}</p>
              </div>
            </div>
          </div>

          {/* Session Selector */}
          <Card>
            <CardHeader className="bg-gray-50 border-b">
              <div className="flex items-center justify-between">
                <div>
                  <CardTitle className="text-lg">Semester / Session</CardTitle>
                  <CardDescription>Select a semester to view registered courses</CardDescription>
                </div>
                <div className="w-64">
                  <Select value={selectedSemester} onValueChange={setSelectedSemester}>
                    <SelectTrigger>
                      <SelectValue placeholder="Select Session" value={selectedSemester} />
                    </SelectTrigger>
                    <SelectContent value={selectedSemester} onValueChange={setSelectedSemester}>
                      <SelectItem value="all">All Semesters</SelectItem>
                      {semesters.map(sem => (
                        <SelectItem key={sem} value={sem}>{sem}</SelectItem>
                      ))}
                    </SelectContent>
                  </Select>
                </div>
              </div>
            </CardHeader>
          </Card>

          {/* Quick Stats */}
          <div className="grid grid-cols-1 md:grid-cols-4 gap-4">
            <Card>
              <CardContent className="pt-6">
                <div className="flex items-center justify-between">
                  <div>
                    <p className="text-xs font-medium text-gray-600 uppercase">CGPA</p>
                    <p className="text-2xl font-bold text-gray-900 mt-1">{audit.CGPA}</p>
                  </div>
                  <div className="h-10 w-10 bg-blue-100 rounded-full flex items-center justify-center">
                    <TrendingUp className="h-5 w-5 text-blue-600" />
                  </div>
                </div>
              </CardContent>
            </Card>

            <Card>
              <CardContent className="pt-6">
                <div className="flex items-center justify-between">
                  <div>
                    <p className="text-xs font-medium text-gray-600 uppercase">Total Credits</p>
                    <p className="text-2xl font-bold text-gray-900 mt-1">{audit.totalCreditsEarned}</p>
                    <p className="text-xs text-gray-500">of {audit.totalCreditsRequired}</p>
                  </div>
                  <div className="h-10 w-10 bg-green-100 rounded-full flex items-center justify-center">
                    <CheckCircle className="h-5 w-5 text-green-600" />
                  </div>
                </div>
              </CardContent>
            </Card>

            <Card>
              <CardContent className="pt-6">
                <div className="flex items-center justify-between">
                  <div>
                    <p className="text-xs font-medium text-gray-600 uppercase">Courses Completed</p>
                    <p className="text-2xl font-bold text-gray-900 mt-1">{audit.completedCourses.length}</p>
                  </div>
                  <div className="h-10 w-10 bg-purple-100 rounded-full flex items-center justify-center">
                    <BookOpen className="h-5 w-5 text-purple-600" />
                  </div>
                </div>
              </CardContent>
            </Card>

            <Card>
              <CardContent className="pt-6">
                <div className="flex items-center justify-between">
                  <div>
                    <p className="text-xs font-medium text-gray-600 uppercase">Pending Repeats</p>
                    <p className="text-2xl font-bold text-red-600 mt-1">{failedCourses.length}</p>
                    <p className="text-xs text-gray-500">Compulsory</p>
                  </div>
                  <div className="h-10 w-10 bg-red-100 rounded-full flex items-center justify-center">
                    <XCircle className="h-5 w-5 text-red-600" />
                  </div>
                </div>
              </CardContent>
            </Card>
          </div>

          {/* Registered Courses Table */}
          <Card>
            <CardHeader className="bg-gray-800 text-white">
              <CardTitle className="flex items-center justify-between">
                <span>Registered Courses List for: {selectedSemester === 'all' ? 'All Semesters' : selectedSemester}</span>
                {selectedSemester !== 'all' && (
                  <Badge variant="outline" className="bg-white text-gray-800">
                    {filteredCourses.length} Courses
                  </Badge>
                )}
              </CardTitle>
            </CardHeader>
            <CardContent className="p-0">
              <div className="overflow-x-auto">
                <Table>
                  <TableHeader className="bg-gray-100">
                    <TableRow>
                      <TableHead className="font-semibold text-gray-900">Course Code</TableHead>
                      <TableHead className="font-semibold text-gray-900">Course Title</TableHead>
                      <TableHead className="font-semibold text-gray-900">Course Type</TableHead>
                      <TableHead className="font-semibold text-gray-900 text-center">Credits</TableHead>
                      <TableHead className="font-semibold text-gray-900 text-center">Credit Status</TableHead>
                    </TableRow>
                  </TableHeader>
                  <TableBody>
                    {filteredCourses.length === 0 ? (
                      <TableRow>
                        <TableCell colSpan={5} className="text-center py-8 text-gray-500">
                          No courses found for this semester
                        </TableCell>
                      </TableRow>
                    ) : (
                      filteredCourses.map((course, index) => {
                        const creditStatus = getCreditStatus(course);
                        const passed = isPassed(course.grade);
                        return (
                          <TableRow key={index} className={!passed ? 'bg-red-50' : ''}>
                            <TableCell className="font-mono font-medium text-sm">
                              {course.courseCode}
                            </TableCell>
                            <TableCell className="max-w-md">
                              <div className="font-medium text-gray-900">{course.courseName}</div>
                            </TableCell>
                            <TableCell>
                              <Badge
                                variant={course.courseType === 'Core' || course.courseType === 'PC' ? 'default' : 'outline'}
                                className="text-xs"
                              >
                                {course.courseType || 'CORE'}
                              </Badge>
                            </TableCell>
                            <TableCell className="text-center font-medium">
                              {course.credits.toFixed(1)}
                            </TableCell>
                            <TableCell className="text-center">
                              <Badge
                                variant={passed ? 'default' : 'destructive'}
                                className={`font-semibold ${creditStatus.color}`}
                              >
                                {creditStatus.status}
                              </Badge>
                            </TableCell>
                          </TableRow>
                        );
                      })
                    )}
                  </TableBody>
                </Table>
              </div>
            </CardContent>
          </Card>

          {/* Performance Summary */}
          {selectedSemester !== 'all' && filteredCourses.length > 0 && (
            <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
              {/* Current Semester Performance */}
              <Card>
                <CardHeader className="bg-blue-50 border-b">
                  <CardTitle className="text-lg flex items-center">
                    <Award className="h-5 w-5 mr-2 text-blue-600" />
                    CURRENT SEMESTER PERFORMANCE
                  </CardTitle>
                </CardHeader>
                <CardContent className="p-6">
                  <div className="space-y-4">
                    <div className="flex justify-between items-center pb-3 border-b">
                      <span className="text-sm font-medium text-gray-600">Total Credits Registered:</span>
                      <span className="text-lg font-bold text-gray-900">{semesterPerf.totalCredits.toFixed(2)}</span>
                    </div>
                    <div className="flex justify-between items-center pb-3 border-b">
                      <span className="text-sm font-medium text-gray-600">Grade Points:</span>
                      <span className="text-lg font-bold text-gray-900">{semesterPerf.totalGradePoints}</span>
                    </div>
                    <div className="flex justify-between items-center">
                      <span className="text-sm font-medium text-gray-600">SPI:</span>
                      <span className="text-2xl font-bold text-blue-600">{semesterPerf.spi}</span>
                    </div>
                  </div>
                </CardContent>
              </Card>

              {/* Cumulative Performance */}
              <Card>
                <CardHeader className="bg-green-50 border-b">
                  <CardTitle className="text-lg flex items-center">
                    <GraduationCap className="h-5 w-5 mr-2 text-green-600" />
                    CUMULATIVE PERFORMANCE INDEX
                  </CardTitle>
                </CardHeader>
                <CardContent className="p-6">
                  <div className="space-y-4">
                    <div className="flex justify-between items-center pb-3 border-b">
                      <span className="text-sm font-medium text-gray-600">Total Credits Earned:</span>
                      <span className="text-lg font-bold text-gray-900">{audit.totalCreditsEarned.toFixed(2)}</span>
                    </div>
                    <div className="flex justify-between items-center pb-3 border-b">
                      <span className="text-sm font-medium text-gray-600">Total Grade Points:</span>
                      <span className="text-lg font-bold text-gray-900">
                        {(audit.totalCreditsEarned * audit.CGPA).toFixed(2)}
                      </span>
                    </div>
                    <div className="flex justify-between items-center">
                      <span className="text-sm font-medium text-gray-600">CGPA:</span>
                      <span className="text-2xl font-bold text-green-600">{audit.CGPA}</span>
                    </div>
                  </div>
                </CardContent>
              </Card>
            </div>
          )}

          {/* Compulsory Course Repeat - F Grade (Must Repeat) */}
          {failedCourses.length > 0 && (
            <Card className="border-l-4 border-red-600">
              <CardHeader className="bg-red-50">
                <CardTitle className="text-lg flex items-center text-red-700">
                  <XCircle className="h-5 w-5 mr-2" />
                  Compulsory Course Repeat - Pending for Credit Completion ({failedCourses.length})
                </CardTitle>
                <CardDescription className="text-red-600 font-medium">
                  F Grade - Must be repeated to earn credits
                </CardDescription>
              </CardHeader>
              <CardContent className="p-6">
                <div className="space-y-2">
                  {failedCourses.map((course, index) => (
                    <div key={index} className="flex items-center justify-between p-4 bg-white rounded-lg border-2 border-red-300">
                      <div className="flex-1">
                        <div className="flex items-center space-x-3">
                          <span className="font-mono font-bold text-red-700 text-lg">{course.courseCode}</span>
                          <span className="text-gray-900 font-medium">{course.courseName}</span>
                        </div>
                        <div className="mt-2 flex items-center space-x-4 text-sm">
                          <span className="text-gray-600">
                            <strong>Type:</strong> {course.courseType || 'Core'}
                          </span>
                          <span className="text-gray-600">
                            <strong>Credits:</strong> {course.credits.toFixed(1)}
                          </span>
                          <span className="text-gray-600">
                            <strong>Semester:</strong> {course.semester}
                          </span>
                        </div>
                      </div>
                      <div className="flex flex-col items-end space-y-2">
                        <Badge variant="destructive" className="text-base font-bold">F Grade</Badge>
                        <Badge className="bg-red-600">COMPULSORY REPEAT</Badge>
                      </div>
                    </div>
                  ))}
                </div>
                <div className="mt-4 p-4 bg-red-100 border-2 border-red-300 rounded-lg">
                  <p className="text-sm text-red-900 font-semibold">
                    ⚠️ <strong>IMPORTANT:</strong> These courses must be repeated and passed to complete your degree. Credits will only be earned after passing.
                  </p>
                </div>
              </CardContent>
            </Card>
          )}

          {/* Courses Available for Grade Improvement (CD or any passed grade) */}
          {improvementCourses.length > 0 && (
            <Card className="border-l-4 border-yellow-500">
              <CardHeader className="bg-yellow-50">
                <CardTitle className="text-lg flex items-center text-yellow-700">
                  <TrendingUp className="h-5 w-5 mr-2" />
                  Courses Available for Re-examination to Improve Grade ({improvementCourses.length})
                </CardTitle>
                <CardDescription>
                  You can re-appear in these courses to improve your grade (CD grade or any passed course)
                </CardDescription>
              </CardHeader>
              <CardContent className="p-6">
                <div className="space-y-2">
                  {improvementCourses.map((course, index) => {
                    const gradePoint = getGradePoint(course.grade);
                    const currentGrade = course.grade?.toString().toUpperCase();
                    return (
                      <div key={index} className="flex items-center justify-between p-4 bg-white rounded-lg border border-yellow-300">
                        <div className="flex-1">
                          <div className="flex items-center space-x-3">
                            <span className="font-mono font-bold text-gray-800">{course.courseCode}</span>
                            <span className="text-gray-900 font-medium">{course.courseName}</span>
                          </div>
                          <div className="mt-2 flex items-center space-x-4 text-sm">
                            <span className="text-gray-600">
                              <strong>Type:</strong> {course.courseType || 'Core'}
                            </span>
                            <span className="text-gray-600">
                              <strong>Credits:</strong> {course.credits.toFixed(1)} {isPassed(course.grade) ? '(Done)' : ''}
                            </span>
                            <span className="text-gray-600">
                              <strong>Current Grade:</strong> {currentGrade} ({gradePoint}/10)
                            </span>
                          </div>
                        </div>
                        <div className="flex flex-col items-end space-y-2">
                          <Badge
                            variant={currentGrade === 'CD' ? 'destructive' : 'outline'}
                            className="text-sm font-semibold"
                          >
                            {currentGrade}
                          </Badge>
                          <Badge className="bg-yellow-600">CAN IMPROVE</Badge>
                        </div>
                      </div>
                    );
                  })}
                </div>
                <div className="mt-4 p-4 bg-yellow-100 border border-yellow-300 rounded-lg">
                  <p className="text-sm text-yellow-900">
                    💡 <strong>Note:</strong> You can re-appear in these courses to improve your grade. CD grade courses are especially recommended for improvement.
                  </p>
                </div>
              </CardContent>
            </Card>
          )}

          {/* Compulsory Core Courses Pending */}
          {compulsoryCourses.length > 0 && (
            <Card className="border-l-4 border-orange-500">
              <CardHeader className="bg-orange-50">
                <CardTitle className="text-lg flex items-center text-orange-700">
                  <AlertCircle className="h-5 w-5 mr-2" />
                  Compulsory Core Courses Pending for Credit Completion ({compulsoryCourses.length})
                </CardTitle>
                <CardDescription className="text-orange-600 font-medium">
                  These core courses must be completed for degree requirements
                </CardDescription>
              </CardHeader>
              <CardContent className="p-6">
                <div className="space-y-2">
                  {compulsoryCourses.map((course, index) => (
                    <div key={index} className="flex items-center justify-between p-4 bg-white rounded-lg border-2 border-orange-300">
                      <div className="flex-1">
                        <div className="flex items-center space-x-3">
                          <span className="font-mono font-bold text-orange-700">{course.courseCode}</span>
                          <span className="text-gray-900 font-medium">{course.courseName}</span>
                        </div>
                        <div className="mt-2 flex items-center space-x-4 text-sm">
                          <span className="text-gray-600">
                            <strong>Type:</strong> Core/Program Core
                          </span>
                          <span className="text-gray-600">
                            <strong>Credits:</strong> {course.credits.toFixed(1)}
                          </span>
                          <span className="text-gray-600">
                            <strong>Status:</strong> Credits Not Earned
                          </span>
                        </div>
                      </div>
                      <Badge className="bg-orange-600">CORE - REQUIRED</Badge>
                    </div>
                  ))}
                </div>
              </CardContent>
            </Card>
          )}

          {/* Degree Progress */}
          <Card>
            <CardHeader>
              <CardTitle>Degree Completion Progress</CardTitle>
              <CardDescription>Track your overall progress towards degree completion</CardDescription>
            </CardHeader>
            <CardContent>
              <div className="space-y-4">
                <div>
                  <div className="flex justify-between mb-2">
                    <span className="text-sm font-medium text-gray-700">Overall Progress</span>
                    <span className="text-sm font-semibold text-gray-900">
                      {audit.totalCreditsEarned} / {audit.totalCreditsRequired} credits ({Math.round((audit.totalCreditsEarned / audit.totalCreditsRequired) * 100)}%)
                    </span>
                  </div>
                  <div className="w-full bg-gray-200 rounded-full h-3">
                    <div
                      className="bg-gradient-to-r from-blue-500 to-blue-600 h-3 rounded-full transition-all duration-500"
                      style={{ width: `${Math.min((audit.totalCreditsEarned / audit.totalCreditsRequired) * 100, 100)}%` }}
                    ></div>
                  </div>
                </div>

                <div className="grid grid-cols-1 md:grid-cols-3 gap-4 mt-6">
                  {audit.categoryProgress.map((category, index) => (
                    <div key={index} className="border rounded-lg p-4">
                      <h4 className="font-medium text-gray-900 mb-2">{category.category}</h4>
                      <div className="flex justify-between text-sm mb-1">
                        <span className="text-gray-600">{category.creditsEarned} / {category.creditsRequired} credits</span>
                        <span className="font-semibold">{category.percentComplete}%</span>
                      </div>
                      <div className="w-full bg-gray-200 rounded-full h-2">
                        <div
                          className={`h-2 rounded-full ${category.status === 'Satisfied' ? 'bg-green-500' : 'bg-blue-500'}`}
                          style={{ width: `${category.percentComplete}%` }}
                        ></div>
                      </div>
                      <Badge variant={category.status === 'Satisfied' ? 'default' : 'outline'} className="mt-2 text-xs">
                        {category.status}
                      </Badge>
                    </div>
                  ))}
                </div>
              </div>
            </CardContent>
          </Card>
        </div>
      </Layout>
    );
  }
